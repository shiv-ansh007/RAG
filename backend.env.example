# ============================================================
# AI Journal — RAG MVP
# Environment variable template
# ============================================================
# Copy this file to backend/.env and fill in the real values.
 


# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d


# ============================================================
# Embeddings
# ============================================================
# Supported provider:
# gemini
#
# Gemini is used to generate embeddings.
# The resulting vectors are stored in Supabase pgvector.
# ============================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536

# Required when EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key


# ============================================================
# LLM Provider
# ============================================================
# Supported modes:
#
# openrouter
#   → Use OpenRouter only
#
# ollama
#   → Use Ollama only
#
# auto
#   → Try OpenRouter first
#   → If OpenRouter fails, automatically try Ollama
#
# ============================================================
LLM_PROVIDER=auto


# ============================================================
# OpenRouter
# ============================================================
# Used when LLM_PROVIDER=openrouter
# or as the primary provider when LLM_PROVIDER=auto
# ============================================================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your-openrouter-model


# ============================================================
# Ollama
# ============================================================
# Used when LLM_PROVIDER=ollama
# or as the fallback provider when LLM_PROVIDER=auto
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ============================================================
# RAG
# ============================================================
RAG_TOP_K=5


# ============================================================
# Server
# ============================================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
